    {
      "name": "converted feedback requires a target block",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "add",
          "path": "/lineage/feedbackResolutions/-",
          "value": {
            "sourcePacketId": "RP-DDDDDDDDDDDDDDDDDDDD",
            "feedbackId": "NOTE-001",
            "feedbackDigest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
            "disposition": "converted-to-block",
            "reason": "The note changes the plan."
          }
        }
      ],
      "expected": {
        "code": "SCHEMA_REQUIRED",
        "path": "/lineage/feedbackResolutions/0/targetBlockId"
      }
    },
