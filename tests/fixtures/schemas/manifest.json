  "protocolNegative": [
    {
      "name": "duplicate block IDs fail in protocol validation",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/blocks/1/id",
          "value": "B001"
        }
      ],
      "expected": {
        "code": "DUPLICATE_ID",
        "path": "/blocks/1/id"
      }
    },
    {
      "name": "dangling source refs fail in protocol validation",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/evidence/facts/0/sourceRefs/1",
          "value": "SRC-999"
        }
      ],
      "expected": {
        "code": "UNKNOWN_REFERENCE",
        "path": "/evidence/facts/0/sourceRefs/1"
      }
    },
    {
      "name": "conflict refs must resolve to evidence items",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/evidence/conflicts/0/itemRefs/2",
          "value": "D-999"
        }
      ],
      "expected": {
        "code": "UNKNOWN_REFERENCE",
        "path": "/evidence/conflicts/0/itemRefs/2"
      }
    },
    {
      "name": "next action IDs are unique",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "copy",
          "from": "/continuation/nextActions/0",
          "path": "/continuation/nextActions/-"
        }
      ],
      "expected": {
        "code": "DUPLICATE_ID",
        "path": "/continuation/nextActions/1/id"
      }
    },
    {
      "name": "BCP-47 structure is checked after the coarse schema gate",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/document/language",
          "value": "en-abc"
        }
      ],
      "expected": {
        "code": "INVALID_LANGUAGE_TAG",
        "path": "/document/language"
      }
    },
    {
      "name": "dependency cycles fail in protocol validation",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "replace",
          "path": "/blocks/0/dependencies",
          "value": [
            "B002"
          ]
        }
      ],
      "expected": {
        "code": "DEPENDENCY_CYCLE",
        "path": "/blocks/0/dependencies/0"
      }
    },
    {
      "name": "frozen blocks require approval history",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "add",
          "path": "/approvals/currentFrozen/-",
          "value": "B001"
        }
      ],
      "expected": {
        "code": "FROZEN_WITHOUT_APPROVAL",
        "path": "/approvals/currentFrozen/0"
      }
    },
    {
      "name": "a frozen block approval digest must match its current content",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "add",
          "path": "/approvals/history/-",
          "value": {
            "blockId": "B004",
            "approvedRound": 1,
            "approvedContentDigest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
          }
        },
        {
          "op": "add",
          "path": "/approvals/currentFrozen/-",
          "value": "B004"
        }
      ],
      "expected": {
        "code": "APPROVAL_DIGEST_MISMATCH",
        "path": "/approvals/history/0/approvedContentDigest"
      }
    },
    {
      "name": "approval history cannot cite a future round",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "add",
          "path": "/approvals/history/-",
          "value": {
