  "schemaNegative": [
    {
      "name": "document rejects unknown root fields",
      "schema": "review-document",
      "base": "valid/review-document.json",
      "mutations": [
        {
          "op": "add",
          "path": "/validation",
          "value": {
            "passed": true
          }
        }
      ],
      "expected": {
        "code": "SCHEMA_ADDITIONAL_PROPERTIES",
        "path": "/validation"
      }
    },
