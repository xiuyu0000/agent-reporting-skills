{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deliver-dual-audience-report:schema:review-state:1",
  "title": "ReviewStateV1",
  "description": "Recoverable, non-authorizing browser review state for review-state/1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "doc",
    "savedAt",
    "stateDigest",
    "idHighWater",
    "decisions",
    "sideNotes",
    "topics",
    "reopened"
  ],
  "properties": {
    "format": { "const": "review-state/1" },
    "doc": { "$ref": "#/$defs/StateDocumentIdentity" },
    "savedAt": { "$ref": "#/$defs/ZonedDateTime" },
    "stateDigest": { "$ref": "#/$defs/Sha256Digest" },
    "idHighWater": { "$ref": "#/$defs/StateIdHighWater" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/StateDecision" }
    },
    "sideNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/StateSideNote" }
    },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/StateTopic" }
    },
    "overall": { "$ref": "#/$defs/NonEmptyString" },
    "reopened": {
      "type": "array",
      "items": { "$ref": "#/$defs/BlockId" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ZonedDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "DocumentId": {
      "type": "string",
      "pattern": "^RD-[0-9A-F]{20}$"
    },
    "BlockId": {
      "type": "string",
      "pattern": "^B(?=0*[1-9])[0-9]{3,}$"
    },
    "NoteId": {
      "type": "string",
      "pattern": "^NOTE-(?=0*[1-9])[0-9]{3,}$"
    },
    "TopicId": {
      "type": "string",
      "pattern": "^TOP-(?=0*[1-9])[0-9]{3,}$"
    },
    "StateDocumentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentVersion", "round", "reviewDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/DocumentId" },
        "contentVersion": { "type": "integer", "minimum": 1 },
        "round": { "type": "integer", "minimum": 1 },
        "reviewDigest": { "$ref": "#/$defs/Sha256Digest" }
      }
    },
    "StateIdHighWater": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "source",
        "fact",
        "decision",
        "glossary",
        "note",
        "topic"
      ],
      "properties": {
        "block": { "type": "integer", "minimum": 0 },
        "source": { "type": "integer", "minimum": 0 },
        "fact": { "type": "integer", "minimum": 0 },
        "decision": { "type": "integer", "minimum": 0 },
        "glossary": { "type": "integer", "minimum": 0 },
        "note": { "type": "integer", "minimum": 0 },
        "topic": { "type": "integer", "minimum": 0 }
      }
    },
    "StateDecision": {
      "oneOf": [
        { "$ref": "#/$defs/StatePassDecision" },
        { "$ref": "#/$defs/StateEditDecision" },
        { "$ref": "#/$defs/StateTopicDecision" },
        { "$ref": "#/$defs/StateHoldDecision" }
      ]
    },
    "StatePassDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "action"],
      "properties": {
        "blockId": { "$ref": "#/$defs/BlockId" },
        "action": { "const": "PASS" },
        "quote": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "StateEditDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "action", "note"],
      "properties": {
        "blockId": { "$ref": "#/$defs/BlockId" },
        "action": { "const": "EDIT" },
        "note": { "$ref": "#/$defs/NonEmptyString" },
        "quote": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "StateTopicDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "action", "topicId"],
      "properties": {
        "blockId": { "$ref": "#/$defs/BlockId" },
        "action": { "const": "TOPIC" },
        "topicId": { "$ref": "#/$defs/TopicId" },
        "quote": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "StateHoldDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "action", "note"],
      "properties": {
        "blockId": { "$ref": "#/$defs/BlockId" },
        "action": { "const": "HOLD" },
        "note": { "$ref": "#/$defs/NonEmptyString" },
        "quote": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "StateSideNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blockId", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/NoteId" },
        "blockId": { "$ref": "#/$defs/BlockId" },
        "note": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "StateTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/TopicId" },
        "title": { "$ref": "#/$defs/NonEmptyString" },
        "note": { "$ref": "#/$defs/NonEmptyString" },
        "sourceBlockId": { "$ref": "#/$defs/BlockId" }
      }
    }
  }
}
